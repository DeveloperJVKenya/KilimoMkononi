rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── MANUALS ───────────────────────────────────────────────────────────────
    match /manuals/{allFiles=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        (request.auth.token.admin == true || request.auth.token.teacher == true);
      allow create: if request.resource.size < 50 * 1024 * 1024;
    }

    // ── AI DIAGNOSIS PHOTOS ───────────────────────────────────────────────────
    // Path: ai_diagnoses/{userId}/{fileName}
    // - Public read so Kindwise servers can download the URL
    // - Write only allowed by the owner (matched userId == auth uid)
    match /ai_diagnoses/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── ASSET IMAGES (pest/disease library) ───────────────────────────────────
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // ── DENY EVERYTHING ELSE ──────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
